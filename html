    </div>

    <!-- SCRIPT DA APLICAÇÃO + INTEGRAÇÃO ADMOB -->
    <script>
        // ==========================================
        // 1. MÓDULO ADMOB (@capacitor-community/admob)
        // ==========================================
        const ADMOB_CONFIG = {
            // IDs oficiais de teste do Google AdMob — troque pelos IDs de produção antes de publicar na Play Store
            bannerId: 'ca-app-pub-3940256099942544/6300978111',
            interstitialId: 'ca-app-pub-3940256099942544/1033173712',
            rewardedId: 'ca-app-pub-3940256099942544/5224354917',
            isTesting: true,
            interstitialEvery: 3
        };

        const admobBridge = {
            plugin: null,
            ready: false,
            bannerVisible: false,
            interstitialLoaded: false,
            rewardedLoaded: false,
            phraseClicks: 0
        };

        function getCapacitorAdMob() {
            if (window.Capacitor && typeof window.Capacitor.isNativePlatform === 'function' && window.Capacitor.isNativePlatform()) {
                if (window.Capacitor.Plugins && window.Capacitor.Plugins.AdMob) {
                    return window.Capacitor.Plugins.AdMob;
                }
            }
            return null;
        }

        async function initAdMob() {
            const AdMob = getCapacitorAdMob();
            if (!AdMob) {
                console.info('[AdMob] Ambiente web detectado: executando em modo fallback sem SDK nativo.');
                return;
            }

            admobBridge.plugin = AdMob;

            try {
                await AdMob.initialize({
                    testingDevices: ADMOB_CONFIG.isTesting ? ['EMULATOR'] : undefined,
                    initializeForTesting: ADMOB_CONFIG.isTesting
                });

                admobBridge.ready = true;
                registerAdMobListeners(AdMob);
                await prepareInterstitial();
                await prepareRewarded();
            } catch (err) {
                console.warn('[AdMob] Erro ao inicializar:', err);
            }
        }

        function registerAdMobListeners(AdMob) {
            AdMob.addListener('interstitialAdLoaded', () => {
                admobBridge.interstitialLoaded = true;
            });
            AdMob.addListener('interstitialAdDismissed', async () => {
                admobBridge.interstitialLoaded = false;
                await prepareInterstitial();
            });
            AdMob.addListener('interstitialAdFailedToLoad', () => {
                admobBridge.interstitialLoaded = false;
            });

            AdMob.addListener('rewardedVideoAdLoaded', () => {
                admobBridge.rewardedLoaded = true;
            });
            AdMob.addListener('rewardedVideoAdDismissed', async () => {
                admobBridge.rewardedLoaded = false;
                await prepareRewarded();
            });
            AdMob.addListener('rewardedVideoAdFailedToLoad', () => {
                admobBridge.rewardedLoaded = false;
            });
        }

        async function showBannerAd() {
            if (!admobBridge.ready || !admobBridge.plugin) return;
            document.body.classList.add('pb-24');
            if (admobBridge.bannerVisible) return;

            try {
                await admobBridge.plugin.showBanner({
                    adId: ADMOB_CONFIG.bannerId,
                    adSize: 'ADAPTIVE_BANNER',
                    position: 'BOTTOM_CENTER',
                    margin: 0,
                    isTesting: ADMOB_CONFIG.isTesting
                });
                admobBridge.bannerVisible = true;
            } catch (err) {
                console.warn('[AdMob] Erro ao exibir banner:', err);
            }
        }

        async function hideBannerAd() {
            document.body.classList.remove('pb-24');
            if (!admobBridge.ready || !admobBridge.plugin || !admobBridge.bannerVisible) return;

            try {
                await admobBridge.plugin.hideBanner();
                admobBridge.bannerVisible = false;
            } catch (err) {
                console.warn('[AdMob] Erro ao ocultar banner:', err);
            }
        }

        async function prepareInterstitial() {
            if (!admobBridge.ready || !admobBridge.plugin) return;
            try {
                await admobBridge.plugin.prepareInterstitial({
                    adId: ADMOB_CONFIG.interstitialId,
                    isTesting: ADMOB_CONFIG.isTesting
                });
            } catch (err) {
                console.warn('[AdMob] Erro ao preparar interstitial:', err);
            }
        }

        async function maybeShowInterstitialOnPhrase() {
            admobBridge.phraseClicks += 1;
            if (admobBridge.phraseClicks % ADMOB_CONFIG.interstitialEvery !== 0) return;

            if (admobBridge.ready && admobBridge.plugin && admobBridge.interstitialLoaded) {
                try {
                    await admobBridge.plugin.showInterstitial();
                } catch (err) {
                    console.warn('[AdMob] Erro ao exibir interstitial:', err);
                }
            }
        }

        async function prepareRewarded() {
            if (!admobBridge.ready || !admobBridge.plugin) return;
            try {
                await admobBridge.plugin.prepareRewardedVideoAd({
                    adId: ADMOB_CONFIG.rewardedId,
                    isTesting: ADMOB_CONFIG.isTesting
                });
            } catch (err) {
                console.warn('[AdMob] Erro ao preparar rewarded:', err);
            }
        }

        async function showRewardedAd(onRewardGranted) {
            if (!admobBridge.ready || !admobBridge.plugin) {
                onRewardGranted();
                return;
            }

            if (!admobBridge.rewardedLoaded) {
                await prepareRewarded();
                showToast('Preparando o vídeo do Polo Norte... tente novamente em instantes.');
                return;
            }

            let rewarded = false;
            const rewardSub = await admobBridge.plugin.addListener('onRewardedVideoAdReward', () => {
                rewarded = true;
                if (rewardSub && typeof rewardSub.remove === 'function') rewardSub.remove();
                onRewardGranted();
            });

            const dismissSub = await admobBridge.plugin.addListener('rewardedVideoAdDismissed', () => {
                if (rewardSub && typeof rewardSub.remove === 'function') rewardSub.remove();
                if (dismissSub && typeof dismissSub.remove === 'function') dismissSub.remove();
                if (!rewarded) {
                    showToast('Assista até o final para liberar a Bênção VIP do Noel.');
                }
            });

            try {
                await admobBridge.plugin.showRewardedVideoAd();
            } catch (err) {
                if (rewardSub && typeof rewardSub.remove === 'function') rewardSub.remove();
                if (dismissSub && typeof dismissSub.remove === 'function') dismissSub.remove();
                console.warn('[AdMob] Erro ao exibir rewarded:', err);
                onRewardGranted();
            }
        }

        // ==========================================
        // 2. EFEITO DE NEVE DINÂMICA
        // ==========================================
        function createSnow() {
            const container = document.getElementById('snow-container');
            const snowCount = 40;
            for (let i = 0; i < snowCount; i++) {
                const flake = document.createElement('div');
                flake.classList.add('snowflake');
                const size = Math.random() * 6 + 2 + 'px';
                flake.style.width = size;
                flake.style.height = size;
                flake.style.left = Math.random() * 100 + 'vw';
                flake.style.animationDuration = Math.random() * 5 + 5 + 's';
                flake.style.animationDelay = Math.random() * 5 + 's';
                container.appendChild(flake);
            }
        }
        createSnow();

        // ==========================================
        // 3. DADOS E GERADOR SEM REPETIÇÃO
        // ==========================================
        const phrasesData = [
            { id: 1, category: 'family', text: 'Que o espírito de Natal renove em nossos corações a esperança, a união e a alegria. Que a nossa casa seja preenchida com o melhor presente de todos: a presença de quem amamos. Feliz Natal!' },
            { id: 2, category: 'family', text: 'Família reunida, mesa posta e corações aquecidos. Não há presente no mundo que pague a felicidade de estar com vocês nesta data.' },
            { id: 3, category: 'family', text: 'Em cada abraço apertado e em cada risada à mesa mora a verdadeira magia do Natal. Gratidão por ser meu porto seguro.' },
            { id: 4, category: 'friends', text: 'Amizade verdadeira é o melhor presente que eu poderia ter ganho. Que o seu Natal seja iluminado, cheio de paz, sorrisos e muita comemoração. Boas Festas!' },
            { id: 5, category: 'friends', text: 'Para um amigo especial que torna o ano inteiro mais leve: desejo um Natal mágico e um Ano Novo repleto de conquistas!' },
            { id: 6, category: 'friends', text: 'Que nunca nos falte motivo para brindar à vida, às histórias que vivemos e às que ainda vamos escrever juntos. Feliz Natal!' },
            { id: 7, category: 'romance', text: 'O melhor presente debaixo da árvore de Natal é poder passar cada momento ao seu lado. Te amo. Feliz Natal!' },
            { id: 8, category: 'romance', text: 'Meu Natal é perfeito porque tenho você para segurar minha mão e aquecer meu coração. Boas Festas, meu amor!' },
            { id: 9, category: 'romance', text: 'Entre luzes, músicas e sonhos, você continua sendo o meu lugar favorito no mundo. Feliz Natal, meu amor!' },
            { id: 10, category: 'short', text: 'Que a luz do Natal brilhe em sua casa hoje e sempre! 🎄✨' },
            { id: 11, category: 'short', text: 'Amor, paz e união: que o Natal traga o melhor para sua vida! 🎁' },
            { id: 12, category: 'short', text: 'Boas Festas! Que a alegria invada o seu coração.' },
            { id: 13, category: 'short', text: 'Mais amor, menos pressa: viva a magia do Natal! ⭐🎄' }
        ];

        const categoryLabels = {
            all: 'Todas',
            family: 'Família',
            friends: 'Amigos',
            romance: 'Romance',
            short: 'Curtas (Status)'
        };

        let activeCategory = 'all';
        let seenPhraseIdsByCategory = {};
        let currentSpotlightPhrase = null;

        // ==========================================
        // 4. NAVEGAÇÃO ENTRE TELAS + BANNER ADMOB
        // ==========================================
        function navigateTo(screenId) {
            const screens = ['screen-cover', 'screen-phrases', 'screen-card-maker', 'screen-surprise'];
            screens.forEach(id => {
                const el = document.getElementById(id);
                if (id === screenId) {
                    el.classList.remove('hidden');
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                } else {
                    el.classList.add('hidden');
                }
            });

            if (screenId === 'screen-cover') {
                hideBannerAd();
            } else {
                showBannerAd();
            }

            if (screenId === 'screen-phrases') {
                const activeBtn = document.querySelector(`.category-btn[data-category="${activeCategory}"]`);
                filterPhrases(activeCategory, activeBtn);
                updatePhrasePoolCounter();
            }
        }

        function getPoolForCategory(category) {
            return category === 'all'
                ? phrasesData
                : phrasesData.filter(p => p.category === category);
        }

        function updatePhrasePoolCounter() {
            const pool = getPoolForCategory(activeCategory);
            if (!seenPhraseIdsByCategory[activeCategory]) {
                seenPhraseIdsByCategory[activeCategory] = [];
            }
            const seenCount = seenPhraseIdsByCategory[activeCategory].length;
            const counterEl = document.getElementById('phrase-pool-counter');
            if (counterEl) {
                counterEl.textContent = `${seenCount}/${pool.length} vistas (${categoryLabels[activeCategory]})`;
            }
        }

        // Gerar Frase sem Repetir + Gatilho de Interstitial
        function generateUniquePhrase() {
            const pool = getPoolForCategory(activeCategory);
            if (!pool.length) return;

            if (!seenPhraseIdsByCategory[activeCategory]) {
                seenPhraseIdsByCategory[activeCategory] = [];
            }

            let unseen = pool.filter(item => !seenPhraseIdsByCategory[activeCategory].includes(item.id));
            let cycled = false;

            if (unseen.length === 0) {
                seenPhraseIdsByCategory[activeCategory] = currentSpotlightPhrase
                    ? [currentSpotlightPhrase.id]
                    : [];
                unseen = pool.filter(item => !seenPhraseIdsByCategory[activeCategory].includes(item.id));
                if (unseen.length === 0) unseen = pool;
                cycled = true;
            }

            const chosen = unseen[Math.floor(Math.random() * unseen.length)];
            seenPhraseIdsByCategory[activeCategory].push(chosen.id);
            currentSpotlightPhrase = chosen;

            const textEl = document.getElementById('spotlight-phrase-text');
            const catEl = document.getElementById('spotlight-phrase-category');

            textEl.style.opacity = '0';
            setTimeout(() => {
                textEl.textContent = `"${chosen.text}"`;
                catEl.textContent = categoryLabels[chosen.category] || chosen.category;
                textEl.style.opacity = '1';
            }, 140);

            updatePhrasePoolCounter();
            if (cycled) {
                showToast('Todas as frases desta categoria foram exibidas — ciclo reiniciado!');
            }

            // Dispara interstitial a cada N cliques configurados
            maybeShowInterstitialOnPhrase();
        }

        function copySpotlightPhrase() {
            if (!currentSpotlightPhrase) {
                showToast('Gere uma frase primeiro para copiar.');
                return;
            }
            copyPhrase(currentSpotlightPhrase.text);
        }

        function useSpotlightInCard() {
            if (!currentSpotlightPhrase) {
                showToast('Gere uma frase primeiro para enviar ao cartão.');
                return;
            }
            document.getElementById('card-message').value = currentSpotlightPhrase.text;
            updateCardPreview();
            navigateTo('screen-card-maker');
            showToast('Frase aplicada ao seu cartão!');
        }

        // Renderizar Frases com Filtro Ativo Robusto
        function filterPhrases(category, btnElement) {
            activeCategory = category;

            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.classList.remove('bg-christmasGold', 'text-christmasDarkRed');
                btn.classList.add('bg-white/10', 'text-white');
            });
            if (btnElement) {
                btnElement.classList.remove('bg-white/10', 'text-white');
                btnElement.classList.add('bg-christmasGold', 'text-christmasDarkRed');
            }

            const grid = document.getElementById('phrases-grid');
            grid.innerHTML = '';

            const filtered = getPoolForCategory(category);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = 'glass-card p-6 rounded-2xl shadow-xl flex flex-col justify-between border border-white/40 hover:scale-[1.01] transition-transform';

                const p = document.createElement('p');
                p.className = 'font-editorial text-gray-800 text-sm sm:text-base italic mb-4';
                p.textContent = `"${item.text}"`;

                const footer = document.createElement('div');
                footer.className = 'flex items-center justify-between pt-3 border-t border-gray-100';

                const badge = document.createElement('span');
                badge.className = 'text-xs uppercase font-semibold text-christmasRed tracking-wider';
                badge.textContent = categoryLabels[item.category] || item.category;

                const copyBtn = document.createElement('button');
                copyBtn.className = 'px-4 py-2 bg-christmasGreen hover:bg-emerald-800 text-white text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow';
                copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Copiar';
                copyBtn.addEventListener('click', () => copyPhrase(item.text));

                footer.appendChild(badge);
                footer.appendChild(copyBtn);
                card.appendChild(p);
                card.appendChild(footer);
                grid.appendChild(card);
            });

            updatePhrasePoolCounter();
        }

        // Copiar Frase Direta com Fallback Seguro
        function copyPhrase(text) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast('Frase copiada para a área de transferência!');
                }).catch(() => {
                    fallbackCopyText(text);
                });
            } else {
                fallbackCopyText(text);
            }
        }

        function fallbackCopyText(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('Frase copiada para a área de transferência!');
            } catch (err) {
                showToast('Não foi possível copiar automaticamente.');
            }
            document.body.removeChild(textarea);
        }

        // ==========================================
        // 5. GERENCIAMENTO DO CRIADOR DE CARTÕES
        // ==========================================
        let currentCardAsset = '🎄';

        function setCardImage(asset, btn) {
            currentCardAsset = asset;
            document.getElementById('card-custom-img').value = '';
            
            document.querySelectorAll('.sticker-btn').forEach(b => {
                b.classList.remove('border-christmasRed', 'bg-red-50');
                b.classList.add('border-transparent');
            });
            if (btn) {
                btn.classList.remove('border-transparent');
                btn.classList.add('border-christmasRed', 'bg-red-50');
            }
            updateCardPreview();
        }

        function updateCardPreview() {
            const to = document.getElementById('card-to').value || 'Querido(a)';
            const message = document.getElementById('card-message').value || 'Sua mensagem aqui...';
            const from = document.getElementById('card-from').value || 'De alguém especial';
            const customImgUrl = document.getElementById('card-custom-img').value.trim();

            document.getElementById('preview-to').innerText = to;
            document.getElementById('preview-message').innerText = `"${message}"`;
            document.getElementById('preview-from').innerText = from;

            const imgContainer = document.getElementById('preview-img-container');
            if (customImgUrl) {
                imgContainer.innerHTML = `<img src="${customImgUrl}" alt="Ícone" class="w-24 h-24 sm:w-32 sm:h-32 object-cover rounded-2xl shadow-lg border-2 border-white/40" onerror="this.onerror=null; this.src='https://placehold.co/128x128/b91c1c/fbbf24?text=🎄';">`;
            } else {
                imgContainer.innerText = currentCardAsset;
            }
        }

        function setTheme(theme, btn) {
            const previewBox = document.getElementById('card-preview-box');
            
            document.querySelectorAll('.theme-btn').forEach(b => {
                b.classList.remove('border-christmasGold', 'shadow');
                b.classList.add('border-transparent');
            });
            if (btn) {
                btn.classList.remove('border-transparent');
                btn.classList.add('border-christmasGold', 'shadow');
            }

            previewBox.classList.remove(
                'bg-christmasRed', 'bg-christmasGreen', 'bg-amber-100', 
                'bg-indigo-950', 'bg-slate-100', 'bg-rose-600',
                'text-white', 'text-gray-900', 'text-cyan-100', 'text-slate-900',
                'border-christmasGold', 'border-amber-400', 'border-cyan-400', 'border-slate-400', 'border-rose-300'
            );
            
            if (theme === 'red') {
                previewBox.classList.add('bg-christmasRed', 'text-white', 'border-4', 'border-christmasGold');
            } else if (theme === 'green') {
                previewBox.classList.add('bg-christmasGreen', 'text-white', 'border-4', 'border-christmasGold');
            } else if (theme === 'gold') {
                previewBox.classList.add('bg-amber-100', 'text-gray-900', 'border-4', 'border-amber-400');
            } else if (theme === 'blue') {
                previewBox.classList.add('bg-indigo-950', 'text-cyan-100', 'border-4', 'border-cyan-400');
            } else if (theme === 'silver') {
                previewBox.classList.add('bg-slate-100', 'text-slate-900', 'border-4', 'border-slate-400');
            } else if (theme === 'pink') {
                previewBox.classList.add('bg-rose-600', 'text-white', 'border-4', 'border-rose-300');
            }
        }

        function shareCard(method) {
            const to = document.getElementById('card-to').value;
            const message = document.getElementById('card-message').value;
            const from = document.getElementById('card-from').value;
            const customImgUrl = document.getElementById('card-custom-img').value.trim();
            const symbol = customImgUrl ? `[Imagem: ${customImgUrl}]` : currentCardAsset;

            const fullText = `🎄 *Cartão de Natal* ${symbol}\n\nPara: ${to}\n\n"${message}"\n\nCom carinho,\n${from}`;
            
            if (method === 'whatsapp') {
                const encodedText = encodeURIComponent(fullText);
                window.open(`https://api.whatsapp.com/send?text=${encodedText}`, '_blank');
            } else {
                fallbackCopyText(fullText);
                showToast('Cartão copiado! Pronto para enviar!');
            }
        }

        // ==========================================
        // 6. SURPRESA DO PAPAI NOEL + REWARDED ADMOB
        // ==========================================
        const santaMessages = [
            "Ho Ho Ho! O Papai Noel viu que você se esforçou muito este ano. Que o seu Natal seja repleto de sorrisos sinceros e aconchego!",
            "Ho Ho Ho! Meu trenó está carregado de energias positivas e alegrias especialmente reservadas para você e sua família!",
            "Ho Ho Ho! Lembre-se de que o maior presente não está debaixo da árvore, mas sim nas pessoas que caminham ao nosso lado. Tenha um Natal mágico!",
            "Ho Ho Ho! As renas já estão descansadas e eu vim trazer um lembrete: você é especial e merece uma noite inesquecível!",
            "Ho Ho Ho! Que a luz das estrelas guie seus próximos passos e traga serenidade para cada dia do novo ano que se aproxima!"
        ];

        const vipSantaMessages = [
            "✨ Bênção VIP do Polo Norte: Ho Ho Ho! O próximo ano reserva portas abertas, projetos realizados e muita prosperidade para o seu lar. Acredite no seu talento!",
            "✨ Bênção VIP do Polo Norte: Ho Ho Ho! Que cada sonho que você guardou no coração floresça com saúde, paz e conquistas extraordinárias neste novo ciclo!",
            "✨ Bênção VIP do Polo Norte: Ho Ho Ho! Você ganhou o selo dourado do trenó: que nunca falte coragem para recomeçar, sabedoria para decidir e amor para celebrar!"
        ];

        let seenSantaIndices = [];
        let seenVipSantaIndices = [];

        function pickNextNonRepeatingIndex(length, seenList) {
            let unseen = Array.from({ length }, (_, idx) => idx).filter(idx => !seenList.includes(idx));
            if (unseen.length === 0) {
                const lastIdx = seenList[seenList.length - 1];
                seenList.length = 0;
                if (lastIdx !== undefined && length > 1) {
                    seenList.push(lastIdx);
                }
                unseen = Array.from({ length }, (_, idx) => idx).filter(idx => !seenList.includes(idx));
            }
            const chosen = unseen[Math.floor(Math.random() * unseen.length)];
            seenList.push(chosen);
            return chosen;
        }

        function generateSantaMessage(isVip = false) {
            const list = isVip ? vipSantaMessages : santaMessages;
            const seenList = isVip ? seenVipSantaIndices : seenSantaIndices;
            const chosenIndex = pickNextNonRepeatingIndex(list.length, seenList);

            const msgEl = document.getElementById('santa-message');
            const boxEl = document.getElementById('santa-box');
            const badgeEl = document.getElementById('santa-badge');

            msgEl.style.opacity = '0';
            setTimeout(() => {
                msgEl.innerText = list[chosenIndex];
                if (isVip) {
                    boxEl.className = 'bg-amber-50 p-6 rounded-2xl border-2 border-christmasGold min-h-[130px] flex items-center justify-center transition-colors duration-300 shadow-inner';
                    badgeEl.className = 'inline-block text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-christmasGold text-christmasDarkRed';
                    badgeEl.innerText = '👑 Bênção VIP Desbloqueada';
                } else {
                    boxEl.className = 'bg-red-50 p-6 rounded-2xl border border-red-100 min-h-[130px] flex items-center justify-center transition-colors duration-300';
                    badgeEl.className = 'inline-block text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full bg-red-100 text-christmasRed';
                    badgeEl.innerText = 'Correio Oficial do Polo Norte';
                }
                msgEl.style.opacity = '1';
            }, 200);
        }

        function unlockVipSantaSurprise() {
            showRewardedAd(() => {
                generateSantaMessage(true);
                showToast('Bênção VIP do Papai Noel desbloqueada!');
            });
        }

        // ==========================================
        // 7. MODAIS E TOAST
        // ==========================================
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        let toastTimeout;
        function showToast(message) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            toastMsg.innerText = message;
            toast.classList.remove('translate-y-32');
            
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-32');
            }, 3000);
        }

        // Inicializa o SDK do AdMob assim que o DOM estiver pronto
        document.addEventListener('DOMContentLoaded', () => {
            initAdMob();
        });
    </script>
