                        <i class="fa-solid fa-wand-magic-sparkles"></i> Usar no Cartão
                    </button>
                </div>
            </div>
        </div>

        <!-- Filtros de Categoria -->
        <div class="flex flex-wrap gap-2 mb-6 justify-center">
            <button onclick="filterPhrases('all', this)" data-category="all" class="category-btn active px-4 py-2 rounded-xl font-medium text-sm bg-christmasGold text-christmasDarkRed transition shadow">Todas</button>
            <button onclick="filterPhrases('family', this)" data-category="family" class="category-btn px-4 py-2 rounded-xl font-medium text-sm bg-white/10 hover:bg-white/20 text-white transition">Família</button>
            <button onclick="filterPhrases('friends', this)" data-category="friends" class="category-btn px-4 py-2 rounded-xl font-medium text-sm bg-white/10 hover:bg-white/20 text-white transition">Amigos</button>
