    <!-- TELA 2: CRIAR CARTÃO -->
    <div id="screen-card-maker" class="hidden min-h-screen flex flex-col p-4 sm:p-8 relative z-10 max-w-4xl mx-auto">
        <div class="flex items-center justify-between gap-2 mb-8 bg-black/25 p-4 rounded-2xl backdrop-blur">
